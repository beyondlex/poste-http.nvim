{
  "name": "tree-sitter-poste-graphql",
  "version": "0.1.0",
  "description": "GraphQL query language with {{var}} template variables for Poste HTTP",
  "main": "grammar.js",
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "tree-sitter build --wasm",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope": "source.poste_graphql",
      "injection-regex": "poste_graphql"
    }
  ]
}
